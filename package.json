{
  "name": "@tishlang/lattish",
  "version": "1.4.0",
  "type": "module",
  "description": "Lattish runtime — hooks + DOM for Tish JSX",
  "license": "PIF",
  "repository": {
    "type": "git",
    "url": "https://github.com/tishlang/lattish.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "tish": {
    "module": "./src/Lattish.tish"
  },
  "main": "./dist/Lattish.js",
  "module": "./dist/Lattish.js",
  "exports": {
    ".": {
      "tish": "./src/Lattish.tish",
      "import": "./dist/Lattish.js",
      "require": "./dist/Lattish.js",
      "default": "./dist/Lattish.js"
    },
    "./jsx-runtime": {
      "tish": "./src/jsx-runtime.tish",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "tish": "./src/jsx-dev-runtime.tish",
      "import": "./dist/jsx-dev-runtime.js",
      "require": "./dist/jsx-dev-runtime.js",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "examples/"
  ],
  "scripts": {
    "build": "tish build src/Lattish.tish -o dist/Lattish.js --target js && tish build src/jsx-runtime.tish -o dist/jsx-runtime.js --target js && tish build src/jsx-dev-runtime.tish -o dist/jsx-dev-runtime.js --target js && node scripts/append-exports.mjs",
    "tishversion": "tish -V",
    "test": "node test/run-tests.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tishlang/tish": "^2.12.0",
    "jsdom": "^25.0.0",
    "semantic-release": "^25.0.3"
  }
}
